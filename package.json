{
  "name": "desktop-marketplace-posting-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build && npm run test:e2e",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "images:cleanup": "tsx scripts/cleanup-images.ts",
    "db:claim-legacy": "tsx scripts/claim-legacy.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@vercel/blob": "2.8.2",
    "better-auth": "^1.7.12",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "heic2any": "^0.0.4",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
