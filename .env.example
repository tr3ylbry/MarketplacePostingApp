# Local disposable development database only. Never use this password on a public server.
DATABASE_URL=postgresql://marketplace:local-development-only@127.0.0.1:5432/marketplace
# Tests require a separate disposable database.
TEST_DATABASE_URL=postgresql://marketplace:local-development-only@127.0.0.1:5432/marketplace_test
# Generate a unique secret locally: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# GitHub OAuth app callback: http://127.0.0.1:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Private Blob: populated by `vercel env pull .env.local` after linking the project.
# Local OIDC tokens expire and must be refreshed; OIDC is automatic on Vercel.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
# Only if local OIDC is unavailable; server-only static fallback:
# BLOB_READ_WRITE_TOKEN=

# Reverb uses each user's encrypted PAT, entered in integration settings, never a global token.
REVERB_ENVIRONMENT=sandbox
# Dedicated 32 random bytes, hex encoded (64 characters). Never reuse BETTER_AUTH_SECRET.
# Generate privately with Node crypto.randomBytes(32).toString("hex"); never print/commit the value.
REVERB_CREDENTIAL_ENCRYPTION_KEY=

# eBay Stage 9A: Sandbox only; real authorization requires trusted local HTTPS.
# dev:https sets BETTER_AUTH_URL=https://127.0.0.1:3000 for its process.
# Coordinate the development GitHub app callback before real login.
EBAY_ENVIRONMENT=sandbox
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
# Exact registered RuName, NOT the literal callback URL.
EBAY_SANDBOX_RUNAME=
# Separate 32-byte hex key; never reuse auth/Reverb keys. Server-only.
EBAY_CREDENTIAL_ENCRYPTION_KEY=
